{
  "name": "@axiom/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the AxiomVM appliance",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist/src"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "node --test dist/test/*.test.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "axiom",
    "microvm",
    "firecracker",
    "sandbox",
    "agentic"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KanakBarfa/AxiomVM.git",
    "directory": "sdk/typescript"
  },
  "author": "AxiomVM Contributors",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.4.0"
  }
}
